# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL (used for CORS in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Assistant (HuggingFace router)
HUGGINGFACE_API_KEY=

# Telegram login bot
